# Optional — only if using `yarn dev` while `vercel dev` runs API on port 3000
# VITE_API_PROXY=http://localhost:3000
RESEND_API_KEY=re_xxxxxxxx

# Sender — use onboarding@resend.dev for testing until your domain is verified in Resend
RESEND_FROM_EMAIL=Hobby Arena <noreply@hobbyarena.ph>

# Optional — not shown in customer emails (website contact email is CMS-managed)
# SUPPORT_EMAIL=

# Facebook Messenger deep link for balance/refund CTAs in order emails
MESSENGER_URL=https://m.me/hobbyarena.ph

# Public Facebook page (shown in email footers)
FACEBOOK_URL=https://www.facebook.com/hobbyarena.ph

# Display site URL in email footers (logo assets still use PUBLIC_SITE_URL)
PUBLIC_DISPLAY_SITE_URL=https://www.hobbyarena.ph

# Where admin notifications go (new orders, inquiries) — internal only
ADMIN_NOTIFICATION_EMAIL=

# Public site URL for email images (logo, etc.) — use production URL so logos load in Gmail
# PUBLIC_SITE_URL=https://hobbyarena.vercel.app

# Preview storefront URL — always shows full shop while landing page is on (owners test here)
# VITE_PREVIEW_STOREFRONT_URL=https://hobbyarena.vercel.app

# ── Firebase (client-side — safe to expose) ─────────────────────────────
# Get these from Firebase Console → Project settings → Your apps → Web app
# Full setup guide: docs/FIREBASE-SETUP.md
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Comma-separated emails allowed into /admin (until Firebase custom claims are set)
VITE_ADMIN_EMAILS=website.hobbyarena@gmail.com

# local = all localStorage | firebase = products, CMS, design, classifications, customers, orders on Firestore (inquiries stay local)
VITE_DATA_SOURCE=local

# Optional — Firebase Emulator Suite (firebase emulators:start)
# VITE_FIREBASE_USE_EMULATORS=true

# Email simulation — captures outgoing mail locally instead of Resend (auto-on with onboarding@resend.dev)
# EMAIL_SIMULATE=true

# ── Storage maintenance (server-side — Vercel only) ─────────────────────
# Firebase service account JSON (single line) — Firebase Console → Project settings → Service accounts → Generate new private key
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Bucket name if it differs from VITE_FIREBASE_STORAGE_BUCKET
# FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# Secret for the monthly proof cleanup cron (Vercel sets Authorization: Bearer <CRON_SECRET>)
# CRON_SECRET=generate-a-long-random-string
# Delete payment proof files from Storage after this many months (default 12)
# ORDER_PROOF_RETENTION_MONTHS=12
