# Optional — only if using `yarn dev` while `vercel dev` runs API on port 3000
# VITE_API_PROXY=http://localhost:3000
RESEND_API_KEY=re_xxxxxxxx

# Sender — use onboarding@resend.dev for testing until your domain is verified in Resend
RESEND_FROM_EMAIL=Hobby Arena <onboarding@resend.dev>

# Where admin notifications go (new orders, inquiries)
ADMIN_NOTIFICATION_EMAIL=hello@hobbyarena.ph

# Public site URL for email images (logo, etc.) — use production URL so logos load in Gmail
# PUBLIC_SITE_URL=https://hobbyarena.vercel.app

# Preview storefront URL — always shows full shop while landing page is on (owners test here)
# VITE_PREVIEW_STOREFRONT_URL=https://hobbyarena.vercel.app

# ── Firebase (client-side — safe to expose) ─────────────────────────────
# Get these from Firebase Console → Project settings → Your apps → Web app
# Full setup guide: docs/FIREBASE-SETUP.md
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Comma-separated emails allowed into /admin (until Firebase custom claims are set)
VITE_ADMIN_EMAILS=website.hobbyarena@gmail.com

# local = all localStorage | firebase = products, CMS, design, classifications, customers, orders on Firestore (inquiries stay local)
VITE_DATA_SOURCE=local

# Optional — Firebase Emulator Suite (firebase emulators:start)
# VITE_FIREBASE_USE_EMULATORS=true

# Email simulation — captures outgoing mail locally instead of Resend (auto-on with onboarding@resend.dev)
# EMAIL_SIMULATE=true
