{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "devCommand": "vite --port $PORT",
  "crons": [
    {
      "path": "/api/cleanup-order-proofs",
      "schedule": "0 3 1 * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|src/|@|node_modules/|assets/|products/)(?!.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
