rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'website.hobbyarena@gmail.com'
      );
    }

    // Payment proofs — checkout must work for guests.
    // Anonymous Auth is OFF in this project (ADMIN_ONLY_OPERATION), so rules
    // cannot depend on request.auth for guest uploads or getDownloadURL.
    // Paths are unguessable (order id + timestamp). Size-capped only.
    match /order-proofs/{orderId}/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024;
    }

    match /products/{productId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cms/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
